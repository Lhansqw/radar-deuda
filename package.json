{
  "name": "radar-deuda",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de escritorio para detectar y gestionar deuda técnica en repositorios (motor de análisis + IA).",
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/sources",
    "packages/ai",
    "packages/pipeline",
    "packages/cli",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "analyze": "tsx packages/cli/src/cli.ts",
    "models": "tsx packages/cli/src/models-cli.ts",
    "cache": "tsx packages/cli/src/cache-cli.ts",
    "build": "npm run build --workspaces",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/desktop/tsconfig.json && tsc -p apps/desktop/tsconfig.renderer.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "bench": "tsx packages/engine/scripts/bench.ts",
    "desktop": "npm run start -w @radar/desktop",
    "desktop:dev": "npm run dev -w @radar/desktop",
    "desktop:build": "npm run build -w @radar/desktop",
    "e2e:desktop": "npm run desktop:build && tsx apps/desktop/e2e/app.e2e.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
