{
  "name": "radar-deuda",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Plataforma de escritorio para detectar y gestionar deuda técnica en repositorios (motor de análisis + IA).",
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/sources",
    "packages/ai",
    "packages/pipeline",
    "packages/cli",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "analyze": "tsx packages/cli/src/cli.ts",
    "models": "tsx packages/cli/src/models-cli.ts",
    "cache": "tsx packages/cli/src/cache-cli.ts",
    "build": "npm run build --workspaces",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/desktop/tsconfig.json && tsc -p apps/desktop/tsconfig.renderer.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:db": "tsx apps/desktop/scripts/test-db.ts",
    "bench": "tsx packages/engine/scripts/bench.ts",
    "desktop": "npm run start -w @radar/desktop",
    "desktop:dev": "npm run dev -w @radar/desktop",
    "desktop:build": "npm run build -w @radar/desktop",
    "e2e:desktop": "npm run desktop:build && tsx apps/desktop/e2e/app.e2e.ts",
    "dist": "npm run dist -w @radar/desktop --",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "minimatch@^9.0.3": "^11.0.1"
  }
}
