{
  // Interfaz: DOM y JSX, sin tipos de Node. Vite resuelve los módulos.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "paths": {
      // La interfaz solo ve los tipos del motor (módulo puro, sin Node).
      "@radar/engine": ["../../packages/engine/src/types.ts"]
    }
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts"]
}
