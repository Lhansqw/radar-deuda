{
  // Interfaz: DOM y JSX, sin tipos de Node. Vite resuelve los módulos.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "paths": {
      // La interfaz solo ve módulos puros del motor (sin Node): sus tipos y las referencias.
      "@radar/engine": ["../../packages/engine/src/types.ts"],
      "@radar/engine/refs": ["../../packages/engine/src/refs.ts"]
    }
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts"]
}
